<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rompe2">

        <!-- Pantalla inicial -->
        <activity
            android:name=".MenuActivity"
            android:exported="true"> <!-- 👈 esta será la inicial -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantallas que se abren desde el menú -->
        <activity
            android:name=".GameModeActivity"
            android:exported="true" />

        <activity
            android:name=".ClassicModeActivity"
            android:exported="true" />

        <activity
            android:name=".CustomModeActivity"
            android:exported="true" />


    </application>
</manifest>
