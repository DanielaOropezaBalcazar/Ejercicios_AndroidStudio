<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuActivity"
    android:background="@drawable/fondo_menu"
    >

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puzzle Game"
        android:gravity="center"
        android:textSize="40sp"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50sp"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invoca Modos de Juego"
        android:textSize="30sp"
        android:backgroundTint="#75A23B"
        android:id="@+id/btInvocarGameMode"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="150sp"

        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invoca Records Globales"
        android:textSize="30sp"
        android:backgroundTint="#077C70"
        android:id="@+id/btInvoca3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="270sp"

        />

</RelativeLayout>