<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#99A6FF"
    android:padding="30sp"

    >

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingresa un dato"
        android:id="@+id/etDato"
        android:textSize="30sp"
        android:layout_centerInParent="true"

        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invoca Activity 2"
        android:textSize="30sp"
        android:backgroundTint="#75A23B"
        android:id="@+id/btInvoca2"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100sp"

        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invoca Activity 3"
        android:textSize="30sp"
        android:backgroundTint="#077C70"
        android:id="@+id/btInvoca3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="200sp"

        />



</RelativeLayout>