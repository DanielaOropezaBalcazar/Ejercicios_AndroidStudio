<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ClassicModeActivity"
    android:background="#E3EFF5"

    >

    <!-- Contenedor de fichas -->
    <LinearLayout
        android:id="@+id/containerBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32sp">
        <!-- Cronometro -->
        <TextView
            android:id="@+id/tvCronometro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_margin="20sp"
            android:layout_gravity="center"

            />
        <!-- Fila 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvA"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#193cb8"/>
            <TextView
                android:id="@+id/tvB"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="2"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#155dfc"/>
            <TextView
                android:id="@+id/tvC"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="3"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#51A2FF"/>
        </LinearLayout>

        <!-- Fila 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvD"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#6E11B0"/>
            <TextView
                android:id="@+id/tvE"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="5"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#9810fa"/>
            <TextView
                android:id="@+id/tvF"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="6"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#AD7AFF"/>
        </LinearLayout>

        <!-- Fila 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvG"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="7"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#8a0194"/>
            <TextView
                android:id="@+id/tvH"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="8"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#BD00DE"/>
            <TextView
                android:id="@+id/tvX"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:gravity="center"
                android:text="X"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_margin="6sp"
                android:background="#E8E6E6"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:id="@+id/containerButtons"
        style="?android:attr/buttonBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/containerBoard"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32sp"

        >

        <Button
            android:id="@+id/btMezclar"
            android:layout_width="140sp"
            android:layout_height="60sp"
            android:text="Mezclar"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:backgroundTint="#0C8575"
            android:layout_margin="5sp"
            android:layout_gravity="center"
            />

        <Button
            android:id="@+id/btOrdenar"
            android:layout_width="140sp"
            android:layout_height="60sp"
            android:text="Ordenar"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:backgroundTint="#1E32E9"
            android:layout_margin="5sp"
            android:layout_gravity="center"

            />
        <Button
            android:id="@+id/btVolverMenu"
            android:layout_width="wrap_content"
            android:layout_height="60sp"
            android:text="Salir al Menu"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:backgroundTint="#E41F6E"
            android:layout_margin="5sp"
            android:layout_gravity="center"

            />

    </LinearLayout>


</RelativeLayout>

